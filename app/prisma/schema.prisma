// Prisma schema. Provider: Neon Postgres (chosen 3 Oct 2026, see
// docs/DATABASE_PROVIDERS.md). Keep this file plain, portable Postgres:
// no provider-specific features, so a move to another Postgres host
// (e.g. Supabase) stays a data copy plus a connection-string change.
// Every schema change goes through `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app's serverless functions.
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection, used only by migrations. The Neon
  // Vercel integration sets both variables.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Static reference data — Nigerian commercial airports.
/// Seeded from src/lib/data/airports.ts; not written to by the app at runtime.
model Airport {
  id       String  @id @default(cuid())
  iata     String  @unique
  icao     String?
  name     String
  city     String
  state    String
  verified Boolean @default(false)

  @@map("airports")
}

/// Static reference data — Nigerian domestic airlines.
/// Seeded from src/lib/data/airlines.ts; not written to by the app at runtime.
model Airline {
  id                 String   @id @default(cuid())
  name               String
  iata               String?  @unique
  icao               String?
  operationalStatus  String   @default("unknown") // "operating" | "grounded" | "unknown"
  verified           Boolean  @default(false)

  @@map("airlines")
}

/// One row per search submitted through /api/search. Used for basic
/// product analytics/debugging — never treated as a source of truth
/// for flight availability, and never stores full provider responses
/// (those are ephemeral — offers expire in ~30 minutes, see
/// docs/DATA_SOURCES.md).
model FlightSearch {
  id              String   @id @default(cuid())
  origin          String
  destination     String
  departureDate   DateTime
  returnDate      DateTime?
  tripType        String   // "one_way" | "return"
  passengerCount  Int
  cabinClass      String
  provider        String   // which provider adapter served this search, e.g. "mock"
  resultCount     Int
  createdAt       DateTime @default(now())

  @@map("flight_searches")
  @@index([origin, destination])
  @@index([createdAt])
}

/// One observed departure: a flight's scheduled vs actual departure time
/// and status, as reported by a flight-status source (AeroDataBox).
/// Raw material for route-level reliability scores. One row per flight
/// per origin per day; a later fetch of the same flight updates the row
/// (same key as recordKey() in src/lib/ingest/types.ts).
model FlightStatusObservation {
  id                    String    @id @default(cuid())
  flightNumber          String
  airlineIata           String
  origin                String
  destination           String
  /// The scheduled departure's UTC calendar date.
  serviceDate           DateTime  @db.Date
  scheduledDepartureUtc DateTime
  actualDepartureUtc    DateTime?
  status                String    // "scheduled" | "departed" | "arrived" | "cancelled" | "diverted" | "unknown"
  source                String
  fetchedAtUtc          DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([flightNumber, origin, serviceDate])
  @@index([airlineIata, origin, destination, scheduledDepartureUtc])
  @@map("flight_status_observations")
}
